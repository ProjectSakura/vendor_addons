    <!-- Lato -->
    <family customizationType="new-named-family" name="lato">
        <font weight="400" style="normal">Lato-Regular.ttf</font>
        <font weight="400" style="italic">Lato-Italic.ttf</font>
        <font weight="500" style="normal">Lato-Medium.ttf</font>
        <font weight="500" style="italic">Lato-MediumItalic.ttf</font>
        <font weight="700" style="normal">Lato-Bold.ttf</font>
        <font weight="700" style="italic">Lato-BoldItalic.ttf</font>
    </family>
    <alias name="lato-medium" to="lato" weight="500" />
    <alias name="lato-bold" to="lato" weight="700" />

    <!-- Nothing Fonts -->
    <family customizationType="new-named-family" name="nothingdot">
        <font weight="400" style="normal" postScriptName="Ndot-55">NDot55Caps.otf</font>
    </family>
    <family customizationType="new-named-family" name="nothingdot57">
        <font weight="400" style="normal" postScriptName="Ndot-57">NDot57Caps.otf</font>
    </family>
    <family customizationType="new-named-family" name="nothingdot57aligned">
        <font weight="400" style="normal" postScriptName="Ndot-57-Aligned">Ndot-57-Aligned.otf</font>
    </family>
    <alias name="ndot" to="NDot55" />
    <alias name="ndot57" to="NDot57" />
    <alias name="ndot57-align" to="NDot57-Aligned" /> 

    <!-- NothingDot -->
    <family customizationType="new-named-family" name="pixelwars">
        <font weight="400" style="normal" postScriptName="pixelwars">pixelwars.ttf</font>
    </family>
    <alias name="pixelwars" to="pixelwars" weight="400" />

    <!-- OnePlusSans -->
    <family customizationType="new-named-family" name="op-sans">
       <font weight="100" style="normal">OnePlusSans-Thin.ttf</font>
       <font weight="100" style="italic">OnePlusSans-ThinItalic.ttf</font>
       <font weight="300" style="normal">OnePlusSans-Light.ttf</font>
       <font weight="300" style="italic">OnePlusSans-LightItalic.ttf</font>
       <font weight="400" style="normal">OnePlusSans-Regular.ttf</font>
       <font weight="400" style="italic">OnePlusSans-Italic.ttf</font>
       <font weight="500" style="normal">OnePlusSans-Medium.ttf</font>
       <font weight="500" style="italic">OnePlusSans-MediumItalic.ttf</font>
       <font weight="900" style="normal">OnePlusSans-Black.ttf</font>
       <font weight="900" style="italic">OnePlusSans-BlackItalic.ttf</font>
       <font weight="700" style="normal">OnePlusSans-Bold.ttf</font>
       <font weight="700" style="italic">OnePlusSans-BoldItalic.ttf</font>
    </family>
    <alias name="op-sans-thin" to="op-sans" weight="100" />
    <alias name="op-sans-light" to="op-sans" weight="300" />
    <alias name="op-sans-book" to="op-sans" weight="400" />
    <alias name="op-sans-regular" to="op-sans" weight="400" />
    <alias name="op-sans-medium" to="op-sans" weight="500" />
    <alias name="op-sans-bold" to="op-sans" weight="700" />
    <alias name="op-sans-black" to="op-sans" weight="900" />

