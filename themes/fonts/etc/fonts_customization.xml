<?xml version="1.0" encoding="utf-8"?>
<fonts-modification version="1">
    <!-- Evolve Sans -->
    <family customizationType="new-named-family" name="evolvesans">
      <font weight="300" style="normal">MADE_Evolve_Sans_Light.ttf</font>
      <font weight="400" style="italic">MADE_Evolve_Sans_Regular.ttf</font>
      <font weight="500" style="normal">MADE_Evolve_Sans_Medium.ttf</font>
      <font weight="700" style="italic">MADE_Evolve_Sans_Bold.ttf</font>
    </family>
    <alias name="evolvesans-light" to="evolvesans" weight="300" />
    <alias name="evolvesans-regular" to="evolvesans" weight="400" />
    <alias name="evolvesans-medium" to="evolvesans" weight="500" />
    <alias name="evolvesans-bold" to="evolvesans" weight="700" />

    <!-- Google Sans -->
    <family customizationType="new-named-family" name="google-sans">
        <font weight="400" style="normal">GoogleSans-Regular.ttf
            <axis tag="GRAD" stylevalue="0"/>
            <axis tag="opsz" stylevalue="18.0"/>
            <axis tag="wght" stylevalue="400"/>
        </font>
        <font weight="500" style="normal">GoogleSans-Regular.ttf
            <axis tag="GRAD" stylevalue="0"/>
            <axis tag="opsz" stylevalue="18.0"/>
            <axis tag="wght" stylevalue="500"/>
